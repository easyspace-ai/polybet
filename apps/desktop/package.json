{
  "name": "@polybet/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "polybet Desktop — native desktop client for the polybet platform.",
  "homepage": "https://polybet.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/easyspace-ai/polybet.git",
    "directory": "apps/desktop"
  },
  "author": {
    "name": "polybet Team",
    "email": "support@polybet.ai"
  },
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "bundle-cli": "node scripts/bundle-cli.mjs",
    "brand-dev-electron": "node scripts/brand-dev-electron.mjs",
    "dev": "pnpm run bundle-cli && pnpm run brand-dev-electron && electron-vite dev",
    "dev:staging": "pnpm run bundle-cli && pnpm run brand-dev-electron && electron-vite dev --mode staging",
    "build": "pnpm run bundle-cli && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "preview": "electron-vite preview",
    "package": "node scripts/package.mjs",
    "package:all": "node scripts/package.mjs --all-platforms --publish never",
    "package:win": "node scripts/package.mjs --win --x64 --arm64 --publish never",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.7",
    "@polybet/core": "workspace:*",
    "@polybet/ui": "workspace:*",
    "@polybet/views": "workspace:*",
    "electron-updater": "^6.8.3",
    "fix-path": "^5.0.0",
    "get-stream": "^9.0.1",
    "isexe": "^2.0.0",
    "react-router-dom": "^7.6.0",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "undici": "^6.25.0",
    "which": "^4.0.0",
    "ansi-regex": "^6.2.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@polybet/eslint-config": "workspace:*",
    "@polybet/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.28.0",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
