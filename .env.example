# =============================================================================
# Polybet environment configuration
# Copy this file to .env and adjust values for your setup.
#   cp .env.example .env
# =============================================================================

# --- Required ---
DATABASE_URL=file:./router.db?_pragma=foreign_keys(1)
# SQLite database path. Examples:
#   file:./router.db?_pragma=foreign_keys(1)       # relative to CWD
#   file:~/.polybet/router.db?_pragma=foreign_keys(1)

# --- Polymarket API credentials ---
# At least one authentication method is required:
#   Option A) Private key (recommended for trading bots)
POLYMARKET_PRIVATE_KEY=
#   Option B) API key + secret + passphrase (for CLOB API access)
# POLYMARKET_API_KEY=
# POLYMARKET_SECRET=
# POLYMARKET_PASSPHRASE=
# POLYMARKET_FUNDER_ADDRESS=

# --- Network ---
HOST=127.0.0.1
PORT=7633
# PUBLIC_PORT=            # separate port for read-only public API

# --- Polymarket endpoints (defaults are typically correct) ---
# POLYGON_RPC_URL=https://polygon-rpc.com
# POLYMARKET_API_URL=https://clob.polymarket.com
# POLYMARKET_CLOB_WS_URL=
# POLYMARKET_CHAIN_ID=137

# --- Outbound proxy (optional) ---
# HTTP_PLATFORM_PROXY_URL=http://127.0.0.1:15236
# Falls back to ALL_PROXY / HTTPS_PROXY / HTTP_PROXY if not set.

# --- Logging ---
# LOG_LEVEL=info           # debug | info | warn | error
# Process logs append to $HOME/.polybet/logs/server.log (and stdout). Same directory also holds:
#   http-access.log  trade.log  position.log  open.log  stoploss.log  risk-runtime.jsonl
# POLYBET_LOG_DIR=         # override log directory (default: ~/.polybet/logs)
# POLYBET_DISABLE_DISK_LOG=1   # disable file logging (stdout only; category + HTTP access logs skipped too)

# --- Telegram notifications (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_AUTHORIZED_CHAT_ID=

# --- CORS (comma-separated origins) ---
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Mode ---
# READ_ONLY_MODE=false     # set to "true" to disable trade execution

# =============================================================================
# Trade gate / kill-switch (configured via /api/config or bot-settings.json,
# NOT via env). Documented here for operator reference.
# =============================================================================
# riskTradingHalted        # "true" to refuse all new opens (manual halt)
# riskMaxDailyLossUSD      # > 0 enables auto-halt when total PnL (unrealized
#                            mark-to-market on open + realized on closed-in-
#                            window) drops below -value USD
# riskKillSwitchWindowSec  # window over which realized PnL counts toward the
#                            kill switch (default 86400 = 24h; 0 disables
#                            realized-PnL contribution)
# riskMaxOpenPositions     # > 0 caps concurrent open positions per account
# riskBookMaxAgeMs         # > 0 refuses opens when cached book is older
# riskMaxReconcileGapSec   # > 0 refuses opens when no WS market tick in N sec
# priceStopLossAbsCents    # > 0 caps absolute drop from HW (in cents)
#                            (used together with priceStopLossRanges; effective
#                            trail = max(percent_trail, hw - absCents))
# riskHedgeCollateralReservePct
#                          # fraction of CLOB collateral kept UNUSED for fees
#                            and rounding (default 0.05 = 5% headroom). The
#                            hedge BUY is clamped so it never exceeds
#                            available_collateral * (1 - reservePct).
# riskHedgeMinUSDC         # smallest hedge USDC the close path will submit;
#                            below it the hedge tier aborts so the operator
#                            notices instead of misfiring on a dust BUY.
# riskCloseMaxSlippageBps  # > 0 refuses FOK/FAK SELL whose projected limit
#                            floor would drop more than this many bps below
#                            the eval bid. Hedge tier is exempt. 0 disables;
#                            suggested production value: 1000 (= 10%).

# riskMaxAccountExposureUSD  # > 0 caps total open cost-basis per account
# riskMaxMarketExposureUSD   # > 0 caps open cost-basis per Polymarket event
#                              (both YES and NO sides count together)
# riskBlockOpenAfterStartSec
#                          # > 0 refuses new opens when market kicked off
#                            more than N seconds ago. Tokens with unknown
#                            start_time are NOT blocked.
# syncDefaultTakerFeeRate    # default fee fraction used by sync when a
#                              Gamma row carries no feeRate / feeRateBps /
#                              takerBaseFee field. Per-market fee still wins.
# riskHwUseMicroPrice      # "true" to ratchet HW with depth-weighted
#                            micro-price instead of max(bid,ask). Prevents
#                            single thin top-of-book ticks from inflating HW.
# riskHwMinDepthUsd        # > 0 USD requires top-of-book depth on at least
#                            one side before HW is allowed to advance.
# orderSubmitMaxAgeMs      # > 0 enables /book refresh + recompute when
#                            elapsed time since the initial fetch exceeds
#                            this threshold; suggested production value 1500.
# riskCloseExecutionMode   # "fok_sell" | "fak_sell" | "hedge_fok_buy" | "ladder"
# riskCloseLadderTiers     # JSON array of per-attempt tiers when
#                            riskCloseExecutionMode = "ladder"
