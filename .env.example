# =============================================================================
# Polybet environment configuration
# Copy this file to .env and adjust values for your setup.
#   cp .env.example .env
# =============================================================================

# --- Required ---
DATABASE_URL=file:./router.db?_pragma=foreign_keys(1)
# SQLite database path. Examples:
#   file:./router.db?_pragma=foreign_keys(1)       # relative to CWD
#   file:~/.polybet/router.db?_pragma=foreign_keys(1)

# --- Polymarket API credentials ---
# At least one authentication method is required:
#   Option A) Private key (recommended for trading bots)
POLYMARKET_PRIVATE_KEY=
#   Option B) API key + secret + passphrase (for CLOB API access)
# POLYMARKET_API_KEY=
# POLYMARKET_SECRET=
# POLYMARKET_PASSPHRASE=
# POLYMARKET_FUNDER_ADDRESS=

# --- Network ---
HOST=127.0.0.1
PORT=7633
# PUBLIC_PORT=            # separate port for read-only public API

# --- Polymarket endpoints (defaults are typically correct) ---
# POLYGON_RPC_URL=https://polygon-rpc.com
# POLYMARKET_API_URL=https://clob.polymarket.com
# POLYMARKET_CLOB_WS_URL=
# POLYMARKET_CHAIN_ID=137

# --- Outbound proxy (optional) ---
# HTTP_PLATFORM_PROXY_URL=http://127.0.0.1:15236
# Falls back to ALL_PROXY / HTTPS_PROXY / HTTP_PROXY if not set.

# --- Logging ---
# LOG_LEVEL=info           # debug | info | warn | error

# --- Telegram notifications (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_AUTHORIZED_CHAT_ID=

# --- CORS (comma-separated origins) ---
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Mode ---
# READ_ONLY_MODE=false     # set to "true" to disable trade execution
